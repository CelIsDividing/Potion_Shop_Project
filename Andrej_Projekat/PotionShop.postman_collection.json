  "item": [
    {
      "name": "Customer - Ana Jovanovic",
      "description": "Complete customer flow. Run '01 - Login' and the token will be saved and used automatically for all other requests in the folder.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get('token');",
              "if (token && token.trim() !== '') {",
              "    pm.request.headers.upsert({ key: 'Authorization', value: 'Bearer ' + token });",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "01 - Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "pm.collectionVariables.set('customerId', res.id);",
                  "pm.collectionVariables.set('token', res.token);",
                  "pm.test('Login successful - status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns the user ID', () => pm.expect(res.id).to.be.a('number'));",
                  "pm.test('Returns a JWT token', () => pm.expect(res.token).to.be.a('string').and.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.jovanovic@example.com\",\n  \"password\": \"123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user-service/api/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user-service",
                "api",
                "users",
                "login"
              ]
            }
          }
        },
        {
